// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
}

// NextAuth default models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // For credentials login
  bio           String?
  handle        String?   @unique
  githubUrl     String?
  twitterUrl    String?
  role          String    @default("USER") // "USER" | "ADMIN"
  status        String    @default("ACTIVE") // "ACTIVE" | "BANNED"

  // Notification preferences
  notifyComments  Boolean @default(true)
  notifyVotes     Boolean @default(true)
  notifyFollowers Boolean @default(false)
  notifyDigest    Boolean @default(false)
  notifySecurity  Boolean @default(true)

  // Appearance preferences
  theme           String  @default("light") // "light" | "dark" | "system"
  codeTheme       String  @default("vs-code-dark-modern")

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  votes         Vote[]
  comments      Comment[]
  reports       Report[]
  bookmarks     Bookmark[]
  collections   BookmarkCollection[]
  notifications Notification[]
  following     Follow[] @relation("follower")
  followers     Follow[] @relation("following")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom Model for OTP Verification
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────
// Post (รองรับทั้ง CODE และ PROMPT)
// ─────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  type        String   // 'CODE' | 'PROMPT'
  title       String
  description String?  @db.Text
  content     String?  @db.Text    // code content หรือ prompt text
  language    String?              // ภาษาโค้ด เช่น "React", "Python"
  aiModel     String?              // สำหรับ Prompt เช่น "Midjourney v6"
  imageUrl    String?              // URL รูปผลงาน (Prompt)
  tags        String[]             // ["React", "Python"]
  copyCount   Int      @default(0)  // จำนวนครั้งที่ถูก Copy

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes       Vote[]
  comments    Comment[]
  reports     Report[]
  bookmarks   Bookmark[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────
// Vote (1 คน = 1 โหวต ต่อ 1 โพสต์)
// ─────────────────────────────────────────────
model Vote {
  id     String @id @default(cuid())
  type   String // 'UP' | 'DOWN'

  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

// ─────────────────────────────────────────────
// Comment (ความคิดเห็น)
// ─────────────────────────────────────────────
model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  userId  String
  postId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}

// ─────────────────────────────────────────────
// Report (รายงานโพสต์ที่ไม่เหมาะสม)
// ─────────────────────────────────────────────
model Report {
  id           String   @id @default(cuid())
  reason       String   // เหตุผล เช่น "สแปม", "เนื้อหาไม่เหมาะสม", ฯลฯ
  status       String   @default("PENDING") // "PENDING" | "RESOLVED" | "DISMISSED"

  userId       String
  postId       String?
  postTitle    String?  // แคชชื่อโพสต์กรณีโพสต์ถูกลบ
  authorHandle String?  // แคช handle ผู้เขียนกรณีโพสต์ถูกลบ
  authorName   String?  // แคชชื่อผู้เขียนกรณีโพสต์ถูกลบ

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())

  @@index([postId])
  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Bookmark Collection (หมวดหมู่ที่ผู้ใช้สร้างเอง)
// ─────────────────────────────────────────────
model BookmarkCollection {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([isPublic])
}

// ─────────────────────────────────────────────
// Bookmark (บันทึกโพสต์ไว้ดูภายหลัง)
// ─────────────────────────────────────────────
model Bookmark {
  id           String   @id @default(cuid())

  userId       String
  postId       String
  collectionId String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  collection   BookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([collectionId])
}

// ─────────────────────────────────────────────
// Follow (ระบบติดตาม)
// ─────────────────────────────────────────────
model Follow {
  id          String   @id @default(cuid())

  followerId  String   // คนที่กดติดตาม
  followingId String   // คนที่ถูกติดตาม
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─────────────────────────────────────────────
// Notification (การแจ้งเตือนในแอป)
// ─────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  type      String   // "VOTE" | "COMMENT" | "FOLLOW" | "COPY_MILESTONE"
  message   String   @db.Text
  link      String?  // URL ไปยังโพสต์หรือหน้าที่เกี่ยวข้อง
  isRead    Boolean  @default(false)

  userId    String   // เจ้าของ Notification (คนที่จะเห็น)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  actorName String?  // ชื่อคนที่ทำกิจกรรม
  postTitle String?  // ชื่อโพสต์ที่เกี่ยวข้อง

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Tag (แท็กหมวดหมู่สำหรับโพสต์)
// ─────────────────────────────────────────────
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("VISIBLE") // "VISIBLE" | "HIDDEN"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────
// SystemSetting (การตั้งค่าระบบสำหรับ Admin)
// ─────────────────────────────────────────────
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


