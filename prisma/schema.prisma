// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// NextAuth default models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // For credentials login
  bio           String?
  handle        String?   @unique

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  votes         Vote[]
  comments      Comment[]
  reports       Report[]
  bookmarks     Bookmark[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom Model for OTP Verification
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────
// Post (รองรับทั้ง CODE และ PROMPT)
// ─────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  type        String   // 'CODE' | 'PROMPT'
  title       String
  description String?  @db.Text
  content     String?  @db.Text    // code content หรือ prompt text
  language    String?              // ภาษาโค้ด เช่น "React", "Python"
  aiModel     String?              // สำหรับ Prompt เช่น "Midjourney v6"
  imageUrl    String?              // URL รูปผลงาน (Prompt)
  tags        String[]             // ["React", "Python"]

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes       Vote[]
  comments    Comment[]
  reports     Report[]
  bookmarks   Bookmark[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────
// Vote (1 คน = 1 โหวต ต่อ 1 โพสต์)
// ─────────────────────────────────────────────
model Vote {
  id     String @id @default(cuid())
  type   String // 'UP' | 'DOWN'

  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

// ─────────────────────────────────────────────
// Comment (ความคิดเห็น)
// ─────────────────────────────────────────────
model Comment {
  id      String @id @default(cuid())
  content String @db.Text

  userId  String
  postId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}

// ─────────────────────────────────────────────
// Report (รายงานโพสต์ที่ไม่เหมาะสม)
// ─────────────────────────────────────────────
model Report {
  id        String   @id @default(cuid())
  reason    String   // เหตุผล เช่น "สแปม", "เนื้อหาไม่เหมาะสม", ฯลฯ
  status    String   @default("PENDING") // "PENDING" | "REVIEWED" | "DISMISSED"

  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// Bookmark (บันทึกโพสต์ไว้ดูภายหลัง)
// ─────────────────────────────────────────────
model Bookmark {
  id        String   @id @default(cuid())

  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}
